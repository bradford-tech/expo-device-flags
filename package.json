{
  "name": "@bradford-tech/expo-device-flags",
  "version": "0.2.0",
  "description": "Persistent per-device flags that survive reinstalls, backed by Apple DeviceCheck (Android via Play Integrity device recall planned).",
  "main": "build/index.js",
  "types": "build/index.d.ts",
  "files": [
    "build",
    "android/build.gradle",
    "android/src/main",
    "ios",
    "src",
    "expo-module.config.json"
  ],
  "scripts": {
    "build": "node internal/module_scripts/build.js",
    "clean": "node internal/module_scripts/clean.js",
    "lint": "eslint src/",
    "test": "node internal/module_scripts/test.js",
    "prepare": "node internal/module_scripts/prepare.js",
    "open:ios": "node internal/module_scripts/open-ios.js",
    "open:android": "node internal/module_scripts/open-android.js"
  },
  "keywords": [
    "react-native",
    "expo",
    "@bradford-tech/expo-device-flags",
    "ExpoDeviceFlags"
  ],
  "repository": "https://github.com/bradford-tech/expo-device-flags",
  "bugs": {
    "url": "https://github.com/bradford-tech/expo-device-flags/issues"
  },
  "author": "sbs44 <83440025+sbs44@users.noreply.github.com> (https://github.com/sbs44)",
  "license": "MIT",
  "homepage": "https://github.com/bradford-tech/expo-device-flags#readme",
  "devDependencies": {
    "@babel/core": "^7.26.0",
    "@types/jest": "^29.2.1",
    "@types/react": "~19.2.4",
    "babel-preset-expo": "~57.0.0",
    "eslint": "~9.39.4",
    "eslint-config-universe": "^15.0.3",
    "expo": "^57.0.7",
    "expo-modules-core": "~57.0.7",
    "jest": "^29.7.0",
    "jest-expo": "~57.0.2",
    "prettier": "^3.0.0",
    "react-native": "0.86.0",
    "typescript": "~7.0.2"
  },
  "jest": {
    "preset": "jest-expo",
    "roots": [
      "<rootDir>/src"
    ]
  },
  "peerDependencies": {
    "expo": "*",
    "react": "*",
    "react-native": "*"
  },
  "allowScripts": {
    "fsevents@2.3.3": true
  }
}
