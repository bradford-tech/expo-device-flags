{
  "name": "device-flags-monorepo",
  "version": "0.0.0",
  "private": true,
  "description": "Monorepo for @bradford-tech/expo-device-flags and @bradford-tech/device-flags-server.",
  "license": "MIT",
  "workspaces": [
    "packages/*"
  ],
  "scripts": {
    "build": "npm run build --workspaces --if-present",
