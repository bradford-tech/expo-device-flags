{
  "name": "@bradford-tech/device-flags-server",
  "version": "1.0.0",
  "description": "Server-side companion for @bradford-tech/expo-device-flags: ES256-authenticated query/update of Apple DeviceCheck's two per-device bits.",
  "type": "module",
  "main": "build/index.js",
  "types": "build/index.d.ts",
  "exports": {
    ".": {
      "types": "./build/index.d.ts",
      "default": "./build/index.js"
    }
  },
  "files": [
    "build"
  ],
  "engines": {
    "node": ">=20"
  },
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "clean": "rm -rf build",
    "lint": "eslint src/ test/",
    "test": "tsc --noEmit -p tsconfig.test.json && vitest run",
    "test:integration": "npm run build && node scripts/integration.mjs",
    "prepare": "npm run build"
  },
  "keywords": [
    "devicecheck",
    "apple",
    "device-flags",
    "expo"
  ],
  "repository": {
    "type": "git",
    "url": "https://github.com/bradford-tech/expo-device-flags.git",
    "directory": "packages/device-flags-server"
  },
  "bugs": {
    "url": "https://github.com/bradford-tech/expo-device-flags/issues"
  },
  "author": "sbs44 <83440025+sbs44@users.noreply.github.com> (https://github.com/sbs44)",
  "homepage": "https://github.com/bradford-tech/expo-device-flags/tree/main/packages/device-flags-server#readme",
  "license": "MIT",
  "devDependencies": {
    "@types/node": "^26.1.2",
    "eslint": "~9.39.4",
    "eslint-config-universe": "^15.2.0",
    "typescript": "~6.0.3",
    "vitest": "^4.1.10"
  }
}
